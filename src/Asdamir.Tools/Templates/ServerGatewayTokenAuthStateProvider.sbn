// Generated by `asdamir new app {{ AppName }}` on {{ GeneratedAtUtc }}.
using System.Net.Http.Json;
using System.Security.Claims;
using Microsoft.AspNetCore.Components.Authorization;
using Microsoft.AspNetCore.Components.Server;

namespace {{ ServerNamespace }}.Auth;

/// <summary>
/// The app's <see cref="AuthenticationStateProvider"/>: the framework's server provider, plus ONE job — the
/// principal it hands out always carries a CURRENT Gateway access token in its <c>access_token</c> claim.
///
/// <para>Pages attach that claim as Bearer on every Gateway call. The token used to be copied into the cookie
/// at sign-in and never renewed, so about an hour (the access-token lifetime) after signing in every CRUD call
/// answered 401 while the cookie session still looked valid — a zombie session. The tokens now live in
/// <see cref="AppUserSessionStore"/>, and each time a page asks for the authentication state this provider
/// asks the store for a valid token; the store renews it through <c>gateway/auth/refresh</c> shortly before it
/// expires (single-flight — a refresh token is single-use).</para>
///
/// <para>When no valid token can be had — the session was signed out elsewhere, the refresh token expired or
/// was revoked (a password change), the app restarted — the state is ANONYMOUS. Pages then send the browser to
/// <c>/logout</c>, which ends the session cleanly instead of leaving it half-alive.</para>
/// </summary>
public sealed class GatewayTokenAuthenticationStateProvider(
    AppUserSessionStore sessions,
    IHttpClientFactory httpFactory,
    ILogger<GatewayTokenAuthenticationStateProvider> logger) : ServerAuthenticationStateProvider
{
    private static readonly AuthenticationState Anonymous = new(new ClaimsPrincipal(new ClaimsIdentity()));

    /// <inheritdoc />
    public override async Task<AuthenticationState> GetAuthenticationStateAsync()
    {
        var state = await base.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true) return state;

        var sid = user.FindFirst(AuthEndpoints.SessionIdClaim)?.Value;
        var token = await sessions.GetAccessTokenAsync(sid, RenewAsync);
        if (string.IsNullOrEmpty(token)) return Anonymous;

        // Same identity, with the access_token claim replaced by the current one.
        var identity = new ClaimsIdentity(
            user.Claims.Where(c => c.Type != "access_token"),
            user.Identity.AuthenticationType);
        identity.AddClaim(new Claim("access_token", token));
        return new AuthenticationState(new ClaimsPrincipal(identity));
    }

    /// <summary>Exchanges the (single-use) refresh token at the Gateway. Null = the Gateway refused it.</summary>
    private async Task<AppUserSessionStore.Tokens?> RenewAsync(string refreshToken, CancellationToken ct)
    {
        var gateway = httpFactory.CreateClient("gatewayNoAuth");
        using var resp = await gateway.PostAsJsonAsync("gateway/auth/refresh", new { refreshToken }, ct);
        if (!resp.IsSuccessStatusCode)
        {
            logger.LogInformation("Token refresh refused by the Gateway ({Status}) — ending the session", (int)resp.StatusCode);
            return null;
        }

        var body = await resp.Content.ReadFromJsonAsync<RefreshResponse>(ct);
        return body?.Tokens is { AccessToken.Length: > 0 } t
            ? new AppUserSessionStore.Tokens(t.AccessToken, t.RefreshToken, t.ExpiresAtUtc)
            : null;
    }

    private sealed record TokenPair(string AccessToken, string RefreshToken, DateTime ExpiresAtUtc, DateTime RefreshExpiresAtUtc);
    private sealed record RefreshResponse(TokenPair? Tokens);
}
