@* Generated by `asdamir new app {{ AppName }}` on {{ GeneratedAtUtc }}. *@
@page "/access-denied"
@attribute [AllowAnonymous]

<PageTitle>Access denied — {{ AppName }}</PageTitle>

<AsdamirStack Orientation="AsdamirStack.StackOrientation.Vertical" HorizontalAlignment="AsdamirStack.StackHorizontalAlignment.Center"
              VerticalGap="16px" Class="u-mt-96">
    <AsdamirLabel Typo="AsdamirLabel.LabelTypo.H3">Access denied</AsdamirLabel>
    <AsdamirLabel Typo="AsdamirLabel.LabelTypo.Body" Class="u-center u-maxw-480">
        Your account doesn't have permission to see this page. If you think that's wrong,
        ask an AdminConsole operator to grant the missing role for this app.
