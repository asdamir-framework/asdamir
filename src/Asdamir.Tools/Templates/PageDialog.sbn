@* <auto-generated>Generated by `asdamir new page {{ EntityName }}` on {{ GeneratedAtUtc }}.</auto-generated> *@
@* Editor form rendered INSIDE an AsdamirModal by {{ EntityPlural }}List (no FluentUI dialog service —
   that can't cross the static-shell → interactive-island boundary in a Blazor Web App). *@
@using {{ Namespace }}.Dtos

@inject Asdamir.Web.Localization.ApiStringLocalizer L

<div class="asd-form-grid">
{{ for f in Fields ~}}
{{ if f.InputKind == "text" ~}}
    <AsdamirTextInput @bind-Value="Model.{{ f.Name }}" Label="@L["Field.{{ EntityName }}.{{ f.Name }}"].Value" Required="@({{ if f.IsRequired }}true{{ else }}false{{ end }})" autocomplete="off" Class="asd-form-w" />
{{ else if f.InputKind == "number" ~}}
    <AsdamirNumberInput TValue="{{ f.CSharpType }}" @bind-Value="Model.{{ f.Name }}" Label="@L["Field.{{ EntityName }}.{{ f.Name }}"].Value" Decimals="{{ f.NumberDecimals }}" autocomplete="off" Class="asd-form-w" />
{{ else if f.InputKind == "bool" ~}}
{{ if f.IsNullable ~}}
    <AsdamirSwitch @bind-Value="{{ f.Name }}Switch" Label="@L["Field.{{ EntityName }}.{{ f.Name }}"].Value" />
{{ else ~}}
    <AsdamirSwitch @bind-Value="Model.{{ f.Name }}" Label="@L["Field.{{ EntityName }}.{{ f.Name }}"].Value" />
{{ end ~}}
{{ else if f.InputKind == "date" ~}}
    <AsdamirDatePicker @bind-Value="{{ f.Name }}Picker" Label="@L["Field.{{ EntityName }}.{{ f.Name }}"].Value" />
{{ else if f.InputKind == "guid" ~}}
    <AsdamirTextInput Value="@Model.{{ f.Name }}.ToString()" Label="@L["Field.{{ EntityName }}.{{ f.Name }}"].Value" ReadOnly="true" autocomplete="off" Class="asd-form-w" />
{{ end ~}}
{{ end ~}}
</div>

@code {
    [Parameter] public {{ EntityName }}Dto Model { get; set; } = default!;
{{ for f in Fields ~}}
{{ if f.InputKind == "date" ~}}

    // AsdamirDatePicker.Value is DateTime?; bridge it to the DTO's {{ f.CSharpType }} {{ f.Name }}
    // so a non-nullable DateTime field also binds (no CS1503).
    private DateTime? {{ f.Name }}Picker
    {
        get => Model.{{ f.Name }};
        set => Model.{{ f.Name }} = value{{ if f.IsNullable }}{{ else }}.GetValueOrDefault(){{ end }};
    }
{{ end ~}}
{{ if f.InputKind == "bool" ~}}
{{ if f.IsNullable ~}}

    // AsdamirSwitch.Value is bool; bridge it to the DTO's bool? {{ f.Name }} (null reads as off).
    private bool {{ f.Name }}Switch
    {
        get => Model.{{ f.Name }} ?? false;
        set => Model.{{ f.Name }} = value;
    }
{{ end ~}}
{{ end ~}}
{{ end ~}}
}
