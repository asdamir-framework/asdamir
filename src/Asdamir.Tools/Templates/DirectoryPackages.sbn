<!-- Generated by `asdamir new app {{ AppName }}` on {{ GeneratedAtUtc }}. -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions / ASP.NET Core (.NET 10)">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Transitively pin Microsoft.OpenApi to close GHSA-v5pm-xwqc-g5wc: the 2.0.0 pulled in
         transitively by Microsoft.AspNetCore.OpenApi is a known high-severity vulnerability (NU1903).
         CentralPackageTransitivePinningEnabled (above) makes this pin apply to the transitive graph. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="FluentUI Blazor">
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.5" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.5" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.8" />
  </ItemGroup>

  <ItemGroup Label="Logging / Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- OpenTelemetry traces + metrics (OTLP) — opt-in via OpenTelemetry:Otlp:Endpoint. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.21.0" />
  </ItemGroup>

  <!--
    Framework.* packages are this app's link to Asdamir modules. Pinned to a PUBLISHED
    release on nuget.org (`dotnet add package Asdamir.Core` resolves it) so the app restores
    on any machine and free-mode apps get JwtService (local JWT issuance). Core/Data carry the
    background-run primitive (Asdamir.*.BackgroundRuns). Bump these on each framework upgrade
    (the add-field / new-entity commands never edit them); the new-app framework-version flag overrides them.
  -->
  <ItemGroup Label="Asdamir (NuGet feed)">
    <!-- The framework ships FOUR packages; an app references Core/Data/Web (Tools is the CLI).
         Contracts/Validation/ErrorHandling/Security/Localization/Configuration are NAMESPACES
         inside Asdamir.Core, not separate packages. -->
    <PackageVersion Include="Asdamir.Core" Version="{{ CoreVersion }}" />
    <PackageVersion Include="Asdamir.Data" Version="{{ DataVersion }}" />
    <PackageVersion Include="Asdamir.Web" Version="{{ WebVersion }}" />
{{ if HasLocalBilling ~}}
    <!-- Free-mode (Model B) billing only: the app-local billing store + payment rails.
         Referenced by the Gateway when scaffolded in free mode with the billing option. -->
    <PackageVersion Include="Asdamir.Payments" Version="{{ PaymentsVersion }}" />
{{ end ~}}
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="bunit" Version="1.40.0" />
    <!-- NU1902 note: bunit 1.40.0 pulls AngleSharp < 1.5.0 (GHSA-pgww-w46g-26qg, mXSS — test-only, never
         shipped). The patched AngleSharp ≥ 1.5.0 breaks bunit 1.x binarily, so the advisory is suppressed
         via NuGetAuditSuppress in Directory.Build.props until a bunit v2 upgrade. -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Transitively pin System.Security.Cryptography.Xml to close GHSA-23rf-6693-g89p / -8q5v-6pqq-x66h /
         -cvvh-rhrc-wg4q / -g8r8-53c2-pm3f (NU1903, high severity): Microsoft.AspNetCore.DataProtection pulls
         10.0.8 transitively, which is vulnerable. CentralPackageTransitivePinningEnabled (above) makes this
         pin apply across the app + its test projects, so a freshly-generated app restores clean. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <!-- Security pin (transitive): System.Security.Cryptography.Pkcs below 10.0.13 carries
         GHSA-846f-f764-76mx (high) / GHSA-2fmv-rv2c-59x7; the Xml pin above was re-raised for
         GHSA-r955-8q5j-3h83 / c399-9853-6jmj / 7hqp-7c5m-4vq6. Pkcs arrives via Microsoft.Data.SqlClient,
         MimeKit and the Data Protection chain. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
