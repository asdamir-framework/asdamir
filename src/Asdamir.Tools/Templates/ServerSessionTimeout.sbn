@* Generated by `asdamir new app {{ AppName }}` on {{ GeneratedAtUtc }}. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IHttpClientFactory Http
@inject ILogger<SessionTimeout> Logger
@inject Asdamir.Web.Localization.ApiStringLocalizer L

@* Inactivity guard. After IdleSeconds with no activity it shows a countdown asking the user to stay;
   "Stay" resets the clock, while the countdown hitting zero — or "Sign out" — goes to /logout, which ENDS
   the session (server-side entry removed + cookie cleared) and then lands on /login. It used to navigate
   straight to /login: the cookie and the server session both stayed valid, so "your session has ended" was
   one Back-button press away from a live dashboard.
   Idle/countdown values come from the Gateway (gateway/client-settings → AppConfigurations); the UI
   never reads the DB. Every string is a DB-backed localization key (App.Session.*), seeded in tr/en/ru by
   the app's onboarding seed. *@
<AsdamirModal Open="_show" OpenChanged="OnOpenChanged" Title="@L["App.Session.Title"].Value">
    <ChildContent>
        <p>@string.Format(System.Globalization.CultureInfo.CurrentCulture, L["App.Session.Body"].Value, _remaining)</p>
    </ChildContent>
    <Footer>
        <button type="button" class="asd-btn" @onclick="LogoutAsync">@L["App.Session.SignOut"]</button>
        <button type="button" class="asd-btn asd-btn-primary" @onclick="StayAsync">@L["App.Session.Stay"]</button>
    </Footer>
</AsdamirModal>

@code {
    [Parameter] public int IdleSeconds { get; set; } = 5 * 60;       // fallback; overridden by config
    [Parameter] public int CountdownSeconds { get; set; } = 30;

    private bool _show;
    private int _remaining;
    private System.Threading.Timer? _countdown;
    private DotNetObjectReference<SessionTimeout>? _ref;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadSettingsAsync();
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("asdIdle.start", _ref, IdleSeconds * 1000);
    }

    private async Task LoadSettingsAsync()
    {
        try
        {
            var gw = Http.CreateClient("gatewayNoAuth");
            var s = await gw.GetFromJsonAsync<ClientSettings>("gateway/client-settings");
            if (s is not null)
            {
                if (s.IdleSeconds > 0) IdleSeconds = s.IdleSeconds;
                if (s.CountdownSeconds > 0) CountdownSeconds = s.CountdownSeconds;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "SessionTimeout: failed to load client settings; using defaults");
        }
    }

    [JSInvokable]
    public Task OnIdle()
    {
        if (_show) return Task.CompletedTask;
        _remaining = CountdownSeconds;
        _show = true;
        _countdown = new System.Threading.Timer(_ => Tick(), null, 1000, 1000);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Tick() => _ = InvokeAsync(async () =>
    {
        _remaining--;
        if (_remaining <= 0) { await LogoutAsync(); return; }
        StateHasChanged();
    });

    private async Task StayAsync()
    {
        StopCountdown();
        _show = false;
        await JS.InvokeVoidAsync("asdIdle.ping");
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        StopCountdown();
        _show = false;
        try { await JS.InvokeVoidAsync("asdIdle.stop"); } catch { /* circuit tearing down */ }
        // /logout, not /login: the session must actually END (see the note at the top of this file).
        Nav.NavigateTo("/logout", forceLoad: true);
    }

    private Task OnOpenChanged(bool open) => open ? Task.CompletedTask : StayAsync();

    private void StopCountdown()
    {
        _countdown?.Dispose();
        _countdown = null;
    }

    public async ValueTask DisposeAsync()
    {
        StopCountdown();
        try { await JS.InvokeVoidAsync("asdIdle.stop"); } catch { /* circuit gone */ }
        _ref?.Dispose();
    }

    private sealed record ClientSettings(int IdleSeconds, int CountdownSeconds);
}
