using Microsoft.Extensions.Logging;

namespace {{ AppName }}.Mobile.Shared.Services;

/// <summary>
/// Login / logout / session against the configured Gateway. Tokens persist via
/// <see cref="ITokenStore"/> (SecureStorage). All HTTP calls go through the
/// named <c>gateway</c> HttpClient — AUD001 enforced.
/// </summary>
public sealed class MobileAuthService
{
    private readonly IHttpClientFactory _httpFactory;
    private readonly ITokenStore _tokens;
    private readonly ILogger<MobileAuthService> _logger;

    public MobileAuthService(IHttpClientFactory httpFactory, ITokenStore tokens, ILogger<MobileAuthService> logger)
    {
        _httpFactory = httpFactory;
        _tokens = tokens;
        _logger = logger;
    }

    public async Task<bool> LoginAsync(string email, string password)
    {
        var client = _httpFactory.CreateClient("gateway");
        HttpResponseMessage resp;
        try
        {
            resp = await client.PostAsJsonAsync("gateway/auth/login", new { Email = email, Password = password });
        }
        catch (Exception ex)
        {
            // AUD007: NEVER include password / email in the log template parameters.
            _logger.LogWarning(ex, "Login HTTP call failed");
            return false;
        }

        if (!resp.IsSuccessStatusCode)
        {
            _logger.LogInformation("Login rejected with status {Status}", (int)resp.StatusCode);
            return false;
        }

        // The Gateway relays AppManagement's login shape: { tokens: { accessToken, refreshToken } }.
        var body = await resp.Content.ReadFromJsonAsync<LoginResponse>();
        var tokens = body?.Tokens;
        if (tokens is null || string.IsNullOrEmpty(tokens.AccessToken))
        {
            _logger.LogWarning("Login response missing access token");
            return false;
        }

        await _tokens.SetTokensAsync(tokens.AccessToken, tokens.RefreshToken);
        var prefix = tokens.AccessToken.Length >= 8 ? tokens.AccessToken[..8] : tokens.AccessToken;
        _logger.LogInformation("Login succeeded, access token prefix '{Prefix}…'", prefix);
        return true;
    }

    // One refresh at a time. A refresh token is SINGLE-USE: two calls that both answer 401 (a screen that
    // loads three lists at once) used to each read the same refresh token and post it concurrently — the
    // second post is a REUSE of a rotated token, which the Gateway treats as theft and answers by revoking
    // the whole chain, signing the user out for doing nothing wrong. Instance-level (this service is a
    // singleton), not static.
    private readonly SemaphoreSlim _refreshGate = new(1, 1);

    /// <summary>
    /// Exchange the stored refresh token for a fresh access token (rotates both) — single-flight. Returns
    /// false when there is no refresh token or the Gateway rejects it (caller should send to login).
    /// </summary>
    /// <param name="staleAccessToken">
    /// The access token the caller just got a 401 for. If, once this call holds the gate, the stored token is
    /// already a DIFFERENT one, another caller refreshed in the meantime — the refresh is skipped and the
    /// caller simply retries with the new token.
    /// </param>
    public async Task<bool> RefreshAsync(string? staleAccessToken = null)
    {
        await _refreshGate.WaitAsync();
        try
        {
            if (staleAccessToken is not null)
            {
                var current = await _tokens.GetAccessTokenAsync();
                if (!string.IsNullOrEmpty(current) && !string.Equals(current, staleAccessToken, StringComparison.Ordinal))
                    return true;
            }

            // Read the refresh token INSIDE the gate, so it is always the latest (post-rotation) one.
            var refresh = await _tokens.GetRefreshTokenAsync();
            if (string.IsNullOrEmpty(refresh)) return false;

            var client = _httpFactory.CreateClient("gateway");
            HttpResponseMessage resp;
            try
            {
                resp = await client.PostAsJsonAsync("gateway/auth/refresh", new { RefreshToken = refresh });
            }
            catch (Exception ex)
            {
                _logger.LogWarning(ex, "Token refresh HTTP call failed");
                return false;
            }

            using (resp)
            {
                if (!resp.IsSuccessStatusCode)
                {
                    _logger.LogInformation("Token refresh rejected with status {Status}", (int)resp.StatusCode);
                    return false;
                }

                var body = await resp.Content.ReadFromJsonAsync<LoginResponse>();
                var tokens = body?.Tokens;
                if (tokens is null || string.IsNullOrEmpty(tokens.AccessToken)) return false;

                await _tokens.SetTokensAsync(tokens.AccessToken, tokens.RefreshToken);
                return true;
            }
        }
        finally
        {
            _refreshGate.Release();
        }
    }

    public Task LogoutAsync() => _tokens.ClearAsync();

    /// <summary>True when an access token is present (a previous login persists across launches).</summary>
    public async Task<bool> IsAuthenticatedAsync()
        => !string.IsNullOrEmpty(await _tokens.GetAccessTokenAsync());

    /// <summary>Decode the signed-in user's identity from the JWT payload (no network call).</summary>
    public async Task<MobileUser?> GetCurrentUserAsync()
    {
        var token = await _tokens.GetAccessTokenAsync();
        if (string.IsNullOrEmpty(token)) return null;
        try
        {
            var parts = token.Split('.');
            if (parts.Length < 2) return null;
            var payload = parts[1].Replace('-', '+').Replace('_', '/');
            payload += (payload.Length % 4) switch { 2 => "==", 3 => "=", _ => "" };
            var json = Encoding.UTF8.GetString(Convert.FromBase64String(payload));
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            // A JWT claim that occurs once is a JSON string; one that occurs several times is a JSON ARRAY.
            // `perm` is one-per-permission, so any user with more than one permission has an array here —
            // and GetString() on an array throws, which used to turn every such user into "not signed in".
            string? Get(string n)
            {
                if (!root.TryGetProperty(n, out var v)) return null;
                return v.ValueKind switch
                {
                    JsonValueKind.String => v.GetString(),
                    JsonValueKind.Array => string.Join(", ", v.EnumerateArray()
                        .Where(e => e.ValueKind == JsonValueKind.String)
                        .Select(e => e.GetString())),
                    JsonValueKind.Null or JsonValueKind.Undefined => null,
                    _ => v.ToString(),
                };
            }
            return new MobileUser(Get("email"), Get("name"), Get("perm"));
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Could not decode the access token payload");
            return null;
        }
    }

    private sealed record LoginResponse(TokenPair? Tokens);
    private sealed record TokenPair(string AccessToken, string? RefreshToken);
}

/// <summary>The signed-in user's identity, decoded from the JWT. <c>Perm</c> is the user's permission codes,
/// comma-separated when there are several.</summary>
public sealed record MobileUser(string? Email, string? Name, string? Perm);
