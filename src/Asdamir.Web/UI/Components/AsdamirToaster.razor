@implements IDisposable
@*
    AsdamirToaster — reusable, dependency-light toast host.

    Lives in the shared Asdamir.Web UI library (web + MAUI Blazor-Hybrid). Deliberately FluentUI-free:
    it does NOT depend on FluentToastProvider/IToastService, so it works inside a Blazor Web App's
    per-page interactive island (where a provider hosted in the static layout is unreachable and the
    service throws, crashing the circuit). Drop one instance on a page and call it imperatively:

      <AsdamirToaster @ref="_toaster" />
      ...
      _toaster.Show("Saved.", AsdamirToaster.Kind.Ok);

    Each toast auto-dismisses; styling comes from the shared design-system CSS (.asd-toast*).

    Accessibility: an ERROR toast is role="alert" (assertive — a screen reader interrupts to announce it);
    success/info toasts are role="status" (polite). Announcing a failure politely meant it could be queued
    behind other speech, or missed entirely before the toast auto-dismissed.
*@

<div class="asd-toaster">
    @foreach (var t in _toasts)
    {
        <div class="asd-toast @t.CssKind" @key="t.Id" role="@t.Role">
            <span class="asd-toast-msg">@t.Message</span>
            <button type="button" class="asd-toast-x" @onclick="@(() => Dismiss(t.Id))" aria-label="Close">✕</button>
        </div>
    }
</div>

@code {
    public enum Kind { Ok, Err, Info }

    private readonly List<ToastItem> _toasts = new();
    private bool _disposed;

    /// <summary>Show a toast; it auto-dismisses after <paramref name="durationMs"/> ms.</summary>
    public void Show(string message, Kind kind = Kind.Ok, int durationMs = 3500)
    {
        // The timer's cancellation source travels WITH the toast, so it is released when that toast goes —
        // by timeout or by the close button. It used to be parked in a list that was only emptied when the
        // whole component was disposed: one leaked source per toast for the life of the page.
        var item = new ToastItem(Guid.NewGuid(), message, kind, new CancellationTokenSource());
        _toasts.Add(item);
        StateHasChanged();

        _ = AutoDismissAsync(item, durationMs);
    }

    private async Task AutoDismissAsync(ToastItem item, int durationMs)
    {
        try { await Task.Delay(durationMs, item.Timer.Token); }
        catch (OperationCanceledException) { return; }
        catch (ObjectDisposedException) { return; }
        if (!_disposed) await InvokeAsync(() => Dismiss(item.Id));
    }

    private void Dismiss(Guid id)
    {
        foreach (var toast in _toasts.Where(t => t.Id == id)) Release(toast);
        _toasts.RemoveAll(t => t.Id == id);
        StateHasChanged();
    }

    private static void Release(ToastItem toast)
    {
        try { toast.Timer.Cancel(); }
        catch (ObjectDisposedException) { /* already released */ }
        toast.Timer.Dispose();
    }

    public void Dispose()
    {
        _disposed = true;
        foreach (var t in _toasts) Release(t);
        _toasts.Clear();
    }

    private sealed record ToastItem(Guid Id, string Message, Kind Kind, CancellationTokenSource Timer)
    {
        public string CssKind => Kind switch { Kind.Ok => "ok", Kind.Err => "err", _ => "info" };
        public string Role => Kind == Kind.Err ? "alert" : "status";
    }
}
