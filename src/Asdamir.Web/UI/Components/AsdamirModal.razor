@*
    AsdamirModal — reusable, dependency-light modal/dialog.

    Lives in the shared Asdamir.Web UI library so BOTH the Blazor web app AND the MAUI Blazor-Hybrid
    mobile app can use it. Deliberately FluentUI-free: it does NOT depend on FluentDialogProvider, so it
    works inside a Blazor Web App's per-page interactive island (where a provider hosted in the static
    layout is unreachable and IDialogService throws). Styling comes from the shared design-system CSS
    (.asd-modal* classes), themed via --asd-* tokens.

      <AsdamirModal Open="_open" OpenChanged="@(v => _open = v)" Title="Detail">
          <p>…body…</p>
          <Footer><button class="asd-btn" @onclick="…">OK</button></Footer>
      </AsdamirModal>

    Keyboard: Escape closes it (same path as the ✕ button and the backdrop), and on opening the dialog takes
    focus so the key press — and a screen reader — land inside it rather than on the page behind. The
    dialog is labelled by its title.
*@

@if (Open)
{
    <div class="asd-modal-overlay" @onclick="CloseAsync">
        <div class="asd-modal" @ref="_dialog" tabindex="-1" @onclick:stopPropagation="true" @onkeydown="OnKeyDownAsync"
             role="dialog" aria-modal="true" aria-labelledby="@_titleId">
            <div class="asd-modal-head">
                <span class="asd-modal-title" id="@_titleId">@Title</span>
                <button type="button" class="asd-iconbtn" @onclick="CloseAsync" aria-label="Close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="asd-modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="asd-modal-foot">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private readonly string _titleId = "asd-modal-title-" + Guid.NewGuid().ToString("N");
    private ElementReference _dialog;
    private bool _wasOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus once per opening, not on every re-render (that would pull focus out of the field being typed in).
        if (Open == _wasOpen) return;
        _wasOpen = Open;
        if (!Open) return;

        try
        {
            await _dialog.FocusAsync();
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or Microsoft.JSInterop.JSDisconnectedException
                                       or InvalidOperationException or OperationCanceledException)
        {
            // No JS runtime yet (static render) or the circuit went away: the dialog still works, unfocused.
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseAsync();
    }

    private async Task CloseAsync()
    {
        if (OpenChanged.HasDelegate) await OpenChanged.InvokeAsync(false);
    }
}
