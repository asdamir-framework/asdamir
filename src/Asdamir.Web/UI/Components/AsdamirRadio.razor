@*
    AsdamirRadio — the framework's ISOLATION radio button: a single native <input type="radio"> styled with
    the shared .asd-* / Fluent-2 tokens, deliberately NOT wrapping FluentUI's FluentRadio. It MUST sit inside
    an <AsdamirRadioGroup>, from which it receives (via a cascading context) the shared group name, the
    selected value, and the change callback.

    It is checked when the group's selected value equals this radio's Value; picking it reports that value back
    up to the group (which raises the group's ValueChanged). The label comes from ChildContent, matching the
    FluentRadio usages migrated. No JS interop.
*@

<label class="asd-radio @(IsDisabled ? "disabled" : null) @Class">
    <input type="radio"
           name="@_group?.Name"
           checked="@(_group is not null && _group.SelectedValue == Value)"
           disabled="@IsDisabled"
           @onchange="OnChangeAsync" />
    @if (ChildContent is not null)
    {
        <span>@ChildContent</span>
    }
</label>

@code {
    [CascadingParameter] private AsdamirRadioGroupContext? _group { get; set; }

    /// <summary>This radio's value — reported to the group when picked; the radio is checked when it equals the group's selected value. Required.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = default!;

    /// <summary>The caption shown beside the radio (markup), matching the child-content FluentRadio usage.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Disables just this radio (in addition to the group-level disabled flag).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra CSS class(es) applied to this radio's <c>&lt;label&gt;</c> wrapper.</summary>
    [Parameter] public string? Class { get; set; }

    private bool IsDisabled => Disabled || (_group?.Disabled ?? false);

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        // A radio's change fires only when it BECOMES selected, so report this radio's value up to the group.
        if (_group is not null)
        {
            await _group.NotifySelectedAsync(Value);
        }
    }
}
