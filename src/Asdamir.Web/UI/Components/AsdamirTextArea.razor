@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string?>

@*
    AsdamirTextArea — the framework's ISOLATION multi-line field: a native <textarea> styled with the
    shared .asd-* / Fluent-2 design tokens, deliberately NOT wrapping FluentUI's FluentTextArea. Consumer
    code binds to this instead, so it carries no dependency on the FluentUI package.

    Form integration: it derives from Blazor's InputBase<string?>, so Value / ValueChanged /
    ValueExpression are emitted and DataAnnotations validation flows through the ambient EditContext with
    zero extra wiring — exactly the shape the migrated FluentTextArea call sites (all @bind-Value) used.

    All user-facing text (Label / Placeholder) is an English-defaulted parameter — a framework component
    can't assume a DB-seeded localization key exists, so the caller passes @L["…"] values in. No JS interop.
*@

<div class="asd-textarea-wrap @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="asd-textarea-label" for="@_id">@Label</label>
    }
    <textarea id="@_id"
              class="asd-input asd-textarea"
              rows="@Rows"
              placeholder="@Placeholder"
              disabled="@Disabled"
              readonly="@ReadOnly"
              required="@Required"
              maxlength="@(MaxLength > 0 ? MaxLength : (int?)null)"
              value="@CurrentValue"
              @onchange="OnChangeAsync"
              @attributes="AdditionalAttributes"></textarea>
</div>

@code {
    private readonly string _id = $"asd-ta-{Guid.NewGuid():N}";

    /// <summary>Number of visible text rows (the native <c>rows</c> attribute). Defaults to <c>3</c>.</summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>
    /// Maximum number of characters accepted (the native <c>maxlength</c> attribute). <c>0</c> (the default)
    /// means no limit.
    /// </summary>
    [Parameter] public int MaxLength { get; set; }

    /// <summary>Field label rendered above the control and associated via <c>for</c>. Pass a localized value.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Placeholder shown when the field is empty. Pass a localized value.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Disables the field entirely (no typing, greyed out).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Renders the field read-only (value shown, not editable) — distinct from <see cref="Disabled"/>.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Marks the field required: sets the native <c>required</c> attribute. Native-only; actual enforcement
    /// (if wanted) comes from a DataAnnotations <c>[Required]</c> validated via the ambient <c>EditContext</c>.
    /// </summary>
    [Parameter] public bool Required { get; set; }

    /// <summary>
    /// Extra CSS class(es) applied to the field's ROOT wrapper (the <c>.asd-textarea-wrap</c> element), so a
    /// layout/width class (e.g. <c>asd-form-w</c>, <c>u-w-full</c>) sizes the whole field. Attributes splatted
    /// via <c>@attributes</c> land on the inner <c>&lt;textarea&gt;</c>; this parameter is the field-level hook.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    {
        // A plain string field — no transform. Same contract as InputTextArea.
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }

    private void OnChangeAsync(ChangeEventArgs e)
        => CurrentValueAsString = e.Value?.ToString();
}
