@*
    AsdamirSwitch — the framework's ISOLATION toggle: an accessible native checkbox (role="switch") drawn
    as a sliding track+knob with the shared .asd-* / Fluent-2 tokens, deliberately NOT wrapping FluentUI's
    FluentSwitch. Consumer code binds to this instead, so it carries no dependency on the FluentUI package.

    Two-way binding is a plain bool via Value + ValueChanged, so @bind-Value (and the @bind-Value:after
    modifier several call sites rely on, e.g. ErrorMonitoring / LocalizationEditor filters) behaves exactly
    as it did with FluentSwitch. The visible caption comes from either the Label parameter OR ChildContent
    (matching both FluentSwitch shapes we migrated). No JS interop.
*@

<label class="asd-switch @(Disabled ? "disabled" : null) @Class">
    <input type="checkbox"
           role="switch"
           checked="@Value"
           disabled="@Disabled"
           aria-checked="@(Value ? "true" : "false")"
           @onchange="OnChangeAsync" />
    <span class="asd-switch-track"></span>
    @if (ChildContent is not null)
    {
        <span>@ChildContent</span>
    }
    else if (!string.IsNullOrEmpty(Label))
    {
        <span>@Label</span>
    }
</label>

@code {
    /// <summary>The toggle state. Supports two-way binding via <c>@bind-Value</c> (and <c>@bind-Value:after</c>).</summary>
    [Parameter] public bool Value { get; set; }

    /// <summary>Raised when the toggle changes — carries the new <see cref="bool"/> state. Enables <c>@bind-Value</c>.</summary>
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>The caption shown beside the switch. Pass a localized value. Ignored when <see cref="ChildContent"/> is set.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Optional caption as markup, an alternative to <see cref="Label"/> (matches the child-content FluentSwitch usage).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Disables the toggle entirely (no interaction, greyed out).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Extra CSS class(es) applied to the switch's <c>&lt;label&gt;</c> wrapper (e.g. a layout modifier).</summary>
    [Parameter] public string? Class { get; set; }

    private async Task OnChangeAsync(ChangeEventArgs e)
    {
        Value = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        await ValueChanged.InvokeAsync(Value);
    }
}
