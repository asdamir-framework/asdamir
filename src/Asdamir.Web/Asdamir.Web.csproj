<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RazorLangVersion>8.0</RazorLangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <AssemblyName>Asdamir.Web</AssemblyName>
    <RootNamespace>Asdamir.Web</RootNamespace>
    <GenerateRazorMetadata>true</GenerateRazorMetadata>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- NuGet Package Metadata -->
    <PackageId>Asdamir.Web</PackageId>
    <!-- Per-project version override: Web is on its own line, independent of the shared
         Directory.Build.props <Version> (Core's line); bump THIS, not the global, for a Web-only release.
         2.0.0 was a MAJOR bump — BREAKING: the notification abstraction INotificationService /
         NotificationService was renamed to IAsdamirNotificationService / AsdamirNotificationService
         (resolves the CS0104 clash with FluentUI v5's same-named INotificationService). Consumers that
         @inject or register the old names must rename them — see CHANGELOG.
         2.0.1 RESTORES the FluentUI-isolation input components AsdamirTextInput + AsdamirNumberInput<T>
         (shipped in 1.6.0) that were accidentally dropped when 2.0.0 branched off before the 1.6.0 merge.
         2.1.1 is a FIX-only release, no API change: (a) AsdamirTextInput dropped a dead @oncompositionend
         handler that .NET 10 does not recognise as an event and that therefore shipped as a literal DOM
         attribute on every field; (b) a new border token for INTERACTIVE controls gives every field and
         button a boundary meeting WCAG 2.1 SC 1.4.11 (>= 3:1) — the decorative one was 1.23:1 on white,
         which is why a correctly rendered input could read as "there is no box here". (Token names are
         spelled out in CHANGELOG.md; a CSS custom property cannot be written in an XML comment.) -->
    <Version>2.1.1</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Web/UI for Asdamir: Blazor + FluentUI component library (DataGrid, dialogs, layout), API-backed localization (3 cultures), and admin pool security (JWT + DataProtection + cookie/bearer handler).</Description>
    <PackageTags>blazor;fluentui;localization;authorization;jwt;data-protection;ui-components</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <!-- Public XML-doc gate ON (regression guard). Every public member of Asdamir.Web is documented
         (UI, Security, Localization). With doc-gen on and CS1591 no longer suppressed, TreatWarningsAsErrors
         makes a new undocumented public member FAIL the build — the same gate Asdamir.Core/Data enforce. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Asdamir.Core/Asdamir.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI / Blazor -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="QuestPDF" />
    <!-- Localization (API-backed, multi-culture) -->
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- Security: JWT, data protection, browser storage, cookie/bearer auth -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Blazored.LocalStorage" />
    <PackageReference Include="Blazored.SessionStorage" />
  </ItemGroup>


  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
