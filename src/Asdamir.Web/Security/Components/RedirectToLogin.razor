@using Asdamir.Web.UI.Components
@inject NavigationManager Nav

@* Orientation left at the default Horizontal to match the prior FluentStack (which also defaulted to
   Horizontal — spinner + label in a centered row). *@
<AsdamirStack VerticalAlignment="AsdamirStack.StackVerticalAlignment.Center"
              HorizontalAlignment="AsdamirStack.StackHorizontalAlignment.Center"
              Class="redirect-login-stack">
    <AsdamirSpinner />
    <AsdamirLabel Typo="AsdamirLabel.LabelTypo.Body" Class="redirect-login-text">
        Redirecting to login...
    </AsdamirLabel>
</AsdamirStack>

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Nav.ToAbsoluteUri(Nav.Uri).PathAndQuery;

        // Don't redirect if already on login page (prevent loop)
        if (returnUrl.StartsWith("/login", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // Redirect to login with return URL
        Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
