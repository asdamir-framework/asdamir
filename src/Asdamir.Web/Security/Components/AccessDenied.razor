@page "/access-denied"
@using Asdamir.Web.UI.Components

<div class="access-denied-container">
    <div class="access-denied-card asd-card">
        <AsdamirStack Orientation="AsdamirStack.StackOrientation.Vertical"
                      HorizontalAlignment="AsdamirStack.StackHorizontalAlignment.Center"
                      VerticalGap="20px">

            <!-- Error Icon -->
            <div class="icon-warning">⚠️</div>

            <AsdamirLabel Typo="AsdamirLabel.LabelTypo.H4">Erişim Reddedildi</AsdamirLabel>
            <AsdamirLabel Typo="AsdamirLabel.LabelTypo.Body" Class="text-center">
                Bu sayfaya erişim yetkiniz bulunmamaktadır. Gerekli izinlere sahip olmadığınız için bu işlemi gerçekleştiremezsiniz.
            </AsdamirLabel>

            <AsdamirStack Orientation="AsdamirStack.StackOrientation.Horizontal" HorizontalGap="12px">
                <AsdamirButton Variant="AsdamirButton.ButtonVariant.Primary" OnClick="GoToDashboard">
                    Ana Sayfaya Dön
                </AsdamirButton>
                <AsdamirButton OnClick="GoBack">
                    Geri Dön
                </AsdamirButton>
            </AsdamirStack>

        </AsdamirStack>
    </div>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void GoToDashboard()
    {
        Navigation.NavigateTo("/dashboard");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}
